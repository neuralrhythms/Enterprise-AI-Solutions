# ─── Kiro IDE ────────────────────────────────────────────────────────────────
.kiro/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env

# ─── RAG pipeline ────────────────────────────────────────────────────────────
# Proprietary source documents — never commit
simple-rag-demo/documents/*
!simple-rag-demo/documents/.gitkeep

# Local PDF staging directory — proprietary, never commit
simple-rag-demo/pdf/

# Vectorstore — generated artefacts from local runs, never commit
simple-rag-demo/vectorstore/*
!simple-rag-demo/vectorstore/.gitkeep

# Internal design notes (not for public repo)
simple-rag-demo/design-principles.md

# ─── Terraform ───────────────────────────────────────────────────────────────
*.tfstate
*.tfstate.backup
.terraform/
terraform.tfvars.local

# ─── simple-rag-demo-v2 ──────────────────────────────────────────────────────
# Proprietary source documents — never commit
simple-rag-demo-v2/documents/*
!simple-rag-demo-v2/documents/.gitkeep

# Local PDF staging directory — proprietary, never commit
simple-rag-demo-v2/pdf/

# Vectorstore — generated artefacts from local runs, never commit
simple-rag-demo-v2/vectorstore/*
!simple-rag-demo-v2/vectorstore/.gitkeep

# Runtime query logs — contain actual user queries, never commit
simple-rag-demo-v2/logs/

# Backup folder — local only, never commit
simple-rag-demo-v2-backup-baseline/
